<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.skyprus.kirgec.GameView
        android:id="@+id/game"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.skyprus.kirgec.HoleView
        android:id="@+id/hole"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView android:id="@+id/btnGolf" style="@style/Pill" android:text="@string/golf" />
            <TextView android:id="@+id/btnBall" style="@style/Pill" android:text="@string/w_ball" />
            <TextView android:id="@+id/btnStone" style="@style/Pill" android:text="@string/w_stone" />
            <TextView android:id="@+id/btnSling" style="@style/Pill" android:text="@string/w_sling" />
            <TextView android:id="@+id/btnBat" style="@style/Pill" android:text="@string/w_bat" />
            <TextView android:id="@+id/btnWrench" style="@style/Pill" android:text="@string/w_wrench" />
            <TextView android:id="@+id/btnMolotov" style="@style/Pill" android:text="@string/w_molotov" />
            <TextView android:id="@+id/btnBoulder" style="@style/Pill" android:text="@string/w_boulder" />
            <TextView android:id="@+id/btnSelect" style="@style/Pill" android:text="@string/select" />
            <TextView android:id="@+id/btnDraw" style="@style/Pill" android:text="@string/draw" />
            <TextView android:id="@+id/btnScan" style="@style/Pill" android:text="@string/scan" />
            <TextView android:id="@+id/btnBoxes" style="@style/Pill" android:text="@string/boxes" />
        </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/holeControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView android:id="@+id/btnBreak" style="@style/Pill" android:text="@string/break_mode" />
            <TextView android:id="@+id/btnRoom" style="@style/Pill" android:text="@string/room" />
            <TextView android:id="@+id/btnAdd" style="@style/Pill" android:text="@string/add_item" />
            <TextView android:id="@+id/btnNewHole" style="@style/Pill" android:text="@string/new_hole" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF0B0C14"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/permission_text"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btnPermission"
            style="@style/Pill"
            android:layout_marginTop="20dp"
            android:text="@string/permission_button" />
    </LinearLayout>
</FrameLayout>
